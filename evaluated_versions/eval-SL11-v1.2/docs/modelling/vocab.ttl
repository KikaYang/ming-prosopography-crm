    rdfs:label "同知建造事"@zh-Hant , "Tongzhi jianzao shi"@en ;
    rdfs:comment "Hucker 1985 文字层未检出，用拼音；位次（D18）"@zh-Hans ;
    crm:P127_has_broader_term type:chaiqian-weici .

type:zongdu-gongcheng-guan a crm:E55_Type ;
    rdfs:label "總督工程官"@zh-Hant , "Zongdu gongcheng guan"@en ;
    rdfs:comment "Hucker 1985 文字层未检出（#7158 總督 为 Supreme Commander，与此不同），用拼音；职责（D18）"@zh-Hans ;
    crm:P127_has_broader_term type:chaiqian-zhize .

type:dushi-guizhi-guan a crm:E55_Type ;
    rdfs:label "督視規制官"@zh-Hant , "Dushi guizhi guan"@en ;
    rdfs:comment "Hucker 1985 文字层未检出，用拼音；职责（D18）"@zh-Hans ;
    crm:P127_has_broader_term type:chaiqian-zhize .

type:jianshi-xuncha-gongcheng-guan a crm:E55_Type ;
    rdfs:label "監視巡察工程官"@zh-Hant , "Jianshi xuncha gongcheng guan"@en ;
    rdfs:comment "Hucker 1985 文字层未检出，用拼音；原文无位次部分，未按 D18 切分"@zh-Hans ;
