    rdfs:label "祀儀成典"@zh-Hant .

# ③ 其他人的头衔与差遣（决策 D15、D22）
# 没有机构的差遣与加衔同样用 mpv:holds_title（定义见 vocab.ttl）。不带时间（D15 规则 2）。
# state 版无法表达：复合差遣两截的配对（D18）、以差遣身份任差遣（D17 的 P15）、差遣所属之事、委派之敕。
# 本官（李时礼部尚书、廖道南中允、张衮等编修）按 D21 不建，同 event 版。

person:130180 mpv:holds_title type:zhi-jianzao-shi ,              # 知建造事（U25）
                              type:zongdu-gongcheng-guan ,        # 總督工程官（U25）
                              type:jianxiu-guan .                 # 監修官（U31）

person:68140 mpv:holds_title type:tongzhi-jianzao-shi ,           # 同知建造事（U27）
                             type:dushi-guizhi-guan ,             # 督視規制官（U27）
                             type:jianxiu-guan .                  # 監修官（U31）

person:127536 mpv:holds_title type:jianshi-xuncha-gongcheng-guan ,   # 監視巡察工程官（U29）
                              type:jianxiu-guan .                    # 監修官（U31）

person:68285 mpv:holds_title type:fu-zongcai-guan .               # 副總裁官（U38）

person:68136 mpv:holds_title type:fu-zongcai-guan .               # 副總裁官（U38）

person:132101 mpv:holds_title type:zuanxiu-guan .                 # 纂修官（U51）

person:130490 mpv:holds_title type:zuanxiu-guan .                 # 纂修官（U51）

person:131629 mpv:holds_title type:zuanxiu-guan .                 # 纂修官（U51）

person:68547 mpv:holds_title type:zuanxiu-guan .                  # 纂修官（U51）

person:68194 mpv:holds_title type:jianshi-xuncha-gongcheng-guan . # 監視巡察工程官（U40）；翰林院、吏科见第⑤块

# ④ 张璁的头衔与差遣（决策 D15、D22）
# state 版只能说"他带过这三个差遣"，说不出属于哪件事、以哪个身份任哪个、谁委派、何时。

person:68266 mpv:holds_title type:zhi-jianzao-shi ,      # 知建造事
                             type:zongdu-gongcheng-guan ,      # 总督工程官
                             type:zongcai-guan .      # 总裁官

# ⑤ 夏言的 P107 + PC107（翰林院、吏科；决策 D22）
# PC107 只能写一个身份，所以"照旧掌科事"（D19 掌事）表达不了；
# P107 是"现在或以前的成员"，也说不出"升翰林"和"仍兼吏科"哪个在先、是否同时。

## 新类型：吏科都给事中（定义见 vocab.ttl）

