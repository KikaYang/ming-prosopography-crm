# SL11 event 版（框架：agent 编写 2026-10-30；④⑥中的待写部分由 Yang 编写）。
# 依据：信息单元清单 J118（info_units.csv v1.2）、决策 D1–D21。共用词汇见 vocab.ttl（检查时用 check_crm.py --vocab docs/modelling/vocab.ttl 一起加载）。
# 原文字符串（rdfs:label @zh-Hant）据清单录文（简体）由 agent 转为繁体，待 Yang 对照影像核实。
# 差遣节点不写 P4：任命时间经 P17 → 降敕 → P4 取得；本卷不能证明差遣的起止。
# 本项目所有 Turtle 文件的前缀。新建 ttl 文件时从这里整段复制。
# URI 方案见 docs/modelling/modelling_decisions.md D8。

@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix mpv:    <https://kikayang.github.io/ming-prosopography-crm/vocab/> .   # 扩展属性与类
@prefix person: <https://kikayang.github.io/ming-prosopography-crm/id/person/> .
@prefix name:   <https://kikayang.github.io/ming-prosopography-crm/id/name/> .
@prefix doc:    <https://kikayang.github.io/ming-prosopography-crm/id/doc/> .
@prefix event:  <https://kikayang.github.io/ming-prosopography-crm/id/event/> .
@prefix ts:     <https://kikayang.github.io/ming-prosopography-crm/id/ts/> .
@prefix group:  <https://kikayang.github.io/ming-prosopography-crm/id/group/> .
@prefix type:   <https://kikayang.github.io/ming-prosopography-crm/id/type/> .
@prefix pc:     <https://kikayang.github.io/ming-prosopography-crm/id/pc/> .
@prefix work:   <https://kikayang.github.io/ming-prosopography-crm/id/work/> .

# W3C 标准前缀
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ① 人物与名称（决策 D6、D21）
# 人物（张璁及其名称、夏言、徐阶、本敕其他人物）的定义见 vocab.ttl
# person:ming-shizong 的定义见 vocab.ttl

# ② 两件“事”（决策 D16）

event:jiaotan-jianzao a crm:E7_Activity ;
    rdfs:label "郊坛建造"@zh-Hans ;
    rdfs:comment "建模者命名。敕中“今大工告竣”（J118-U23）；《明史》卷48 禮二：“於是作圜丘，是年十月工成”（嘉靖九年）"@zh-Hans .

event:siyi-chengdian-xiushu a crm:E7_Activity ;
    rdfs:label "纂辑祀仪成典"@zh-Hans ;
    rdfs:comment "建模者命名。敕中“纂辑成书”（J118-U53）"@zh-Hans .

doc:shizong-shilu-118 crm:P70_documents event:jiaotan-jianzao , event:siyi-chengdian-xiushu .

# ③ 辛未降敕（决策 D2、D7、D14）

event:jj09-10-xinwei-chi a crm:E7_Activity ;
    rdfs:label "降敕"@zh-Hant ;
    crm:P14_carried_out_by person:ming-shizong ;                 # J118-U16、U24“特命”
    crm:P4_has_time-span ts:jj09-10-xinwei ;
    crm:P17_was_motivated_by event:jiaozhi-gengding ,            # J118-U22“郊祀已遵复我皇祖初制……不可无记”
                             event:jiaotan-jianzao ;             # J118-U23“今大工告竣，祀期在迩”
    rdfs:comment "敕中缘由：“朕惟祭祀，国之大事。矧今郊祀已遵复我皇祖初制，其中事宜，不可无记，以垂将来”（U22）；“今大工告竣，祀期在迩”（U23，“祀期在迩”未单独建节点）。此前上谕“俟十月吉”（U19）降敕，“至是”（U21）即十月辛未；“兹先降敕”亦指此（U20）"@zh-Hans .

doc:shizong-shilu-118 crm:P70_documents event:jj09-10-xinwei-chi .

