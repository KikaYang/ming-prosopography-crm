    crm:P82a_begin_of_the_begin "1530-11-14T00:00:00"^^xsd:dateTime ;
    crm:P82b_end_of_the_end     "1530-11-14T23:59:59"^^xsd:dateTime ;
    rdfs:comment "原文：嘉靖九年十月辛未（干支辛未，十月十五）；儒略历 1530-11-04；已与中研院两千年中西历转换核对"@zh-Hans .

name:date-jj09-10-xinwei a crm:E41_Appellation ;
    rdfs:label "嘉靖九年十月辛未"@zh-Hant .

