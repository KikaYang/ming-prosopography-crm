    crm:P11_had_participant person:68266 ;                      # 谁受衔？
    crm:P4_has_time-span ts:jj07-06-01 ;
    crm:P17_was_motivated_by event:minglun-dadian-jincheng ;                     # 起因
    crm:P9_consists_of event:jj07-06-jiaen-1 , event:jj07-06-jiaen-2 ,          
                       event:jj07-06-jiaen-3 , event:jj07-06-jiaen-4 .

