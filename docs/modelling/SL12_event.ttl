    rdfs:label "升謹身殿大學士"@zh-Hant ;
    crm:P2_has_type type:action-sheng ;                    
    mpv:conferred_title type:jinshendian-daxueshi .

# 动作类型 type:action-*（及上位类 type:shouxian-action）的定义见 vocab.ttl

type:jiaen a crm:E55_Type ;
    rdfs:label "加恩"@zh-Hans , "bestowal of honor"@en .

# person:ming-shizong 的定义见 vocab.ttl

