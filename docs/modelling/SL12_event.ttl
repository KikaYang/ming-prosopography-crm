# SL12 event 版。共用词汇见 vocab.ttl（检查时用 check_crm.py --vocab docs/modelling/vocab.ttl 一起加载）。
# 本项目所有 Turtle 文件的前缀。新建 ttl 文件时从这里整段复制。
# URI 方案见 docs/modelling/modelling_decisions.md D8。

@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix mpv:    <https://kikayang.github.io/ming-prosopography-crm/vocab/> .   # 扩展属性与类
@prefix person: <https://kikayang.github.io/ming-prosopography-crm/id/person/> .
@prefix name:   <https://kikayang.github.io/ming-prosopography-crm/id/name/> .
@prefix doc:    <https://kikayang.github.io/ming-prosopography-crm/id/doc/> .
@prefix event:  <https://kikayang.github.io/ming-prosopography-crm/id/event/> .
@prefix ts:     <https://kikayang.github.io/ming-prosopography-crm/id/ts/> .
@prefix group:  <https://kikayang.github.io/ming-prosopography-crm/id/group/> .
@prefix type:   <https://kikayang.github.io/ming-prosopography-crm/id/type/> .
@prefix pc:     <https://kikayang.github.io/ming-prosopography-crm/id/pc/> .

# W3C 标准前缀
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ① 人物与名称（决策 D6）

# person:68266、name:zhang-cong、name:zhang-fujing 的定义见 vocab.ttl
# type:benming、type:ciming 的定义见 vocab.ttl

# ② 史料（决策 D7）
# （定义已移至 vocab.ttl）

# ③ 头衔分类（决策 D4）
# （定义已移至 vocab.ttl）

# ④ 扩展词汇（决策 D2、D10）

mpv:conferred_title a rdf:Property ;
    rdfs:label "conferred title"@en , "授衔"@zh-Hans ;
    rdfs:domain crm:E7_Activity ;
    rdfs:range  crm:E55_Type ;
    rdfs:comment "一次授予活动所授予的头衔。CIDOC-CRM 7.1.3 中没有表达'授予某头衔'的属性：P2 has type 描述的是事件本身的类型，不是事件产出的头衔；P144/P107 要求一个 E74 机构，而加衔没有对应机构。"@zh-Hans .

# 决策 D10：P177 的值域是 E55_Type。CRM 7.1.3 对 P177 的定义说明：
# "properties defined by the CIDOC CRM also constitute instances of E55 Type themselves"。
# RDFS 编码中属性只是 rdf:Property，因此在数据中显式声明被 P177 引用的属性同时为 E55_Type（第⑨块）。
crm:P4_has_time-span a crm:E55_Type .

# ⑤ 卷89：嘉靖七年六月加恩（决策 D1、D2、D3）

event:jj07-06-jiaen a crm:E7_Activity ;
    rdfs:label "嘉靖七年六月加恩纂述諸臣（張璁）"@zh-Hant ;
