    crm:P82a_begin_of_the_begin "1528-06-27T00:00:00"^^xsd:dateTime ;   # 2026-10-24 改：公历换算（D14）
    crm:P82b_end_of_the_end     "1528-06-27T23:59:59"^^xsd:dateTime ;
    rdfs:comment "原文：嘉靖七年六月辛丑朔（干支辛丑）；儒略历 1528-06-17；已与中研院两千年中西历转换核对"@zh-Hans .

